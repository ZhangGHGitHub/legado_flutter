# Local-only Android TTS probe build output
/tools/android_debug_tts_engine/

# Local reference clone of Jingshiro/legado (for UI layout lookup)
/reference/

# Read-only original baselines and local R0 evidence probes. These files are
# never build inputs and must not enter a refactor commit.
/legado-main/
/original_legado.db*
/tools/*.db
/tools/*.png
/tools/*.txt
