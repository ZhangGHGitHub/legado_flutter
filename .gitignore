migrate_working_dir/

# Local secrets / env (never commit)
.env
.env.*
!.env.example

# Local WebDAV smoke-test storage
/.local-webdav/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
