# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust build artifacts
/rust/target/

# ── Development artifacts (analysis, fix scripts, config dumps, emulator) ──
analyze_*.txt
emulator_screen.png
emulator_ui.xml
fix_*.ps1
fix*.py
legado_my*.xml
legado_ref.xml
read_lines*.py
tools_*_tmp.xml
test.txt
